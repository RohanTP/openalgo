# OpenAlgo connection (required)
OPENALGO_API_KEY = 'YOUR_OPENALGO_API_KEY'
OPENALGO_HOST = 'http://127.0.0.1:5000'

# Strategy identity
STRATEGY_NAME = '915_breakout'

# Instrument
UNDERLYING = 'NIFTY'
INDEX_EXCHANGE = 'NSE_INDEX'
DERIVATIVE_EXCHANGE = 'NFO'
PRODUCT = 'MIS'

# Timing
SELECT_TIME = '09:07'
REFERENCE_CANDLE_TIME = '09:15'
TRADE_END_TIME = '10:30'
SQUARE_OFF_TIME = '15:15'

# Option selection
PREMIUM_MIN = '200'
PREMIUM_MAX = '400'
STRIKE_COUNT = '30'

# Position sizing
TOTAL_LOTS = '2'
LOT_SIZE = '75'

# Daily capital gate (premium notional). Debit on BUY, credit on SELL.
# Set 0 to disable. Default 150000.
MAX_CAPITAL_PER_DAY = '150000'

# Order placement robustness
ORDER_MAX_RETRIES = '3'
ORDER_RETRY_DELAY_SEC = '0.2'

# Startup position sync via openposition. Keep false: same symbol may have
# manual / other-strategy qty and reconcile can adopt or clear the wrong plan.
BROKER_RECONCILE = 'false'

# Entry / SL
BIG_CANDLE_THRESHOLD = '40'
BIG_CANDLE_SL_FIB = '0.55'
ENTRY_BUFFER = '0.05'
ENTRY_TRIGGER_BUFFER = '5'
SL_BUFFER = '0.5'

# Targets
FIB_TARGETS = '1.272,1.618,2.0'
BOOKING_PCTS = '0,50,50'

# Trade rules
ALLOW_BOTH_CE_PE = 'true'
ONE_TRADE_PER_DAY = 'false'
POLL_SECONDS = '3'

# Heikin Ashi trailing stop
HA_TRAIL_START_TARGET = '1'
HA_TRAIL_DELAY_MINUTES = '2'

# Logging: INFO | DEBUG | DISABLED
STRATEGY_LOG_LEVEL = 'INFO'
